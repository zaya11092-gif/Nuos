# NuOS distro build profile (base, board-independent).
# Sourced by distro/build-image.sh.
DEBIAN_SUITE=trixie
ARCH=amd64
# Repository components needed for firmware / i915 VA (non-free) and
# firmware-linux-nonfree / intel-microcode.
DEBIAN_COMPONENTS="main,contrib,non-free,non-free-firmware"
# Default hostname baked into the image.
NUOS_HOSTNAME=nuos
# Fixed GPT partition UUIDs (we control them at build time so the kernel
# cmdline and /etc/fstab can reference PARTUUID deterministically).
# NUOS in hex: 4e='N' 55='U' 4f='O' 53='S' — all valid hex digits.
NUOS_ESP_PARTUUID=4e554f53-4f53-4e55-4f53-4e554f530001
NUOS_ROOT_PARTUUID=4e554f53-4f53-4e55-4f53-4e554f530002
