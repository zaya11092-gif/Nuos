[Unit]
Description=NuOS boot health marker (NUOS_BOOT_OK on console)
# Ordered only on software services. Deliberately NOT on hardware-dependent
# units (hostapd, camera daemons): the marker must print even with no Wi-Fi
# dongle / camera attached (QEMU smoke test, bare board bring-up).
Wants=systemd-networkd.service avahi-daemon.service
After=systemd-networkd.service avahi-daemon.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'echo NUOS_BOOT_OK > /dev/console'
RemainAfterExit=yes

[Install]
WantedBy=nuos.target
