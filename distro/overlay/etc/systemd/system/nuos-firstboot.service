[Unit]
Description=NuOS first-boot AP provisioning (SSID + WPA2 PSK generation)
# Runs once per image (marker file check in the script). Needs only the
# network interface to exist, not to be configured.
After=systemd-udevd.service systemd-networkd.service
Before=hostapd.service dnsmasq.service
ConditionPathExists=/sys/class/net/wlan0

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/nuos-firstboot
RemainAfterExit=yes

[Install]
WantedBy=nuos.target
