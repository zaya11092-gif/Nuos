[Unit]
Description=NuOS XR home (Godot compositor)
After=nuos-tracker.service nuos-stream.service
Wants=graphical.target
ConditionPathExists=/opt/nuos/home/bin/nuos-home

[Service]
Type=simple
WorkingDirectory=/opt/nuos/home
Environment=XR_RUNTIME_JSON=/usr/share/openxr/1/openxr_monado.json
Environment=WLR_LIBINPUT_NO_DEVICES=1
ExecStart=/opt/nuos/home/bin/nuos-home
Restart=on-failure
RestartSec=3

[Install]
WantedBy=nuos.target
