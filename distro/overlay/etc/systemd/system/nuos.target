[Unit]
Description=NuOS platform services
Documentation=file:/opt/nuos/README.md
# Individual services carry their own After=/Wants= ordering; this target is
# only an aggregate anchor so the whole board stack can be started/stopped
# together (systemctl isolate nuos.target).
Wants=nuos-boot-ok.service nuos-tracker.service nuos-stream.service \
      nuos-handbus.service nuos-home.service nuos-firstboot.service \
      nuos-power-tune.service

[Install]
WantedBy=multi-user.target
