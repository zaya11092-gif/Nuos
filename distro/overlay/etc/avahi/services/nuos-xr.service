<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">

<!-- NuOS XR session discovery (see proto/PROTOCOL.md): phone browses for
     _nuos-xr._tcp and connects to TCP port 48012 on the board. -->
<service-group>
  <name replace-wildcards="yes">NuOS XR on %h</name>
  <service>
    <type>_nuos-xr._tcp</type>
    <port>48012</port>
    <txt-record>proto=1</txt-record>
    <txt-record>board=nuos</txt-record>
  </service>
</service-group>
