#!/bin/sh
# NuOS board power tuning. Every step is guarded: this must never fail boot
# on other hardware (CI/QEMU).
set -u

# ---- intel_pstate: cap max performance to 70% -------------------------------
PSTATE=/sys/devices/system/cpu/intel_pstate
if [ -d "$PSTATE" ] && [ -w "$PSTATE/max_perf_pct" ]; then
    echo 70 > "$PSTATE/max_perf_pct" \
        && echo "nuos-power-tune: intel_pstate max_perf_pct=70"
fi

# ---- zram swap via zram-tools (/etc/default/zramswap shipped in overlay) ----
# zramswap.service is enabled by the package; config check only here.
if [ -f /etc/default/zramswap ]; then
    # Ensure a sane swap size if the package default is missing.
    grep -q '^PERCENT=' /etc/default/zramswap || echo 'PERCENT=50' >> /etc/default/zramswap
    grep -q '^ALGO=' /etc/default/zramswap || echo 'ALGO=zstd' >> /etc/default/zramswap
    systemctl try-restart zramswap.service || true
    echo "nuos-power-tune: zram configured (PERCENT=50 ALGO=zstd)"
fi

# ---- RAPL: cap package power to 15 W if powercap sysfs exists --------------
for lim in /sys/class/powercap/intel-rapl:0/constraint_0_power_limit_uw; do
    if [ -e "$lim" ] && [ -w "$lim" ]; then
        echo 15000000 > "$lim" \
            && echo "nuos-power-tune: RAPL constraint_0 = 15 W"
    fi
done

# ---- Wi-Fi power save off (latency) -----------------------------------------
for IFACE in /sys/class/net/wlan*; do
    [ -e "$IFACE" ] || continue
    DEV=${IFACE##*/}
    if command -v iw >/dev/null 2>&1; then
        iw dev "$DEV" set power_save off 2>/dev/null \
            && echo "nuos-power-tune: $DEV power_save off"
    fi
done

# ---- USB autosuspend defaults (power; hubs excluded) ------------------------
for CTRL in /sys/bus/usb/devices/*/power/control; do
    [ -e "$CTRL" ] || continue
    case "${CTRL%%/power/*}" in
        */usb*) continue ;;  # root hubs: keep on
    esac
    echo auto > "$CTRL" 2>/dev/null || true
done
echo "nuos-power-tune: USB autosuspend applied"

exit 0
