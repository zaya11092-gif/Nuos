[Unit]
Description=NuOS interactive installer (live medium only)
After=systemd-user-sessions.service getty@tty1.service
ConditionPathExists=/.live-installer

[Service]
Type=oneshot
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
ExecStart=/usr/local/sbin/nuos-install
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
