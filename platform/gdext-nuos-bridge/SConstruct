#!/usr/bin/env python3
# Builds the NuosBridge GDExtension against godot-cpp.
#   scons platform=linux target=template_debug godot_cpp=/path/to/godot-cpp
import os

env = SConscript(os.path.join(os.environ.get("GODOT_CPP", "godot-cpp"), "godot-cpp.SConstruct"))

env.Append(CPPPATH=["src/", "../include", "../../proto"])
env.Append(CXXFLAGS=["-std=c++17", "-fno-strict-aliasing"])
# godot-cpp SConstruct already sets -s; keep linking simple and POSIX-only.
env.Append(LINKFLAGS=["-lrt"])

sources = Glob("src/*.cpp")

if env["platform"] == "macos":
    library = env.SharedLibrary(
        "bin/libnuos_bridge.{}.{}.framework/libnuos_bridge.{}.{}".format(
            "macos", "debug" if env["target"] == "template_debug" else "release",
            "macos", "debug" if env["target"] == "template_debug" else "release"),
        source=sources)
else:
    suffix = "template_debug" if env["target"] == "template_debug" else "template_release"
    library = env.SharedLibrary(
        "bin/libnuos_bridge.linux.{}.x86_64.so".format(suffix),
        source=sources)

Default(library)
